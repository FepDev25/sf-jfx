# Configuracion de sf-jfx
# Copiar a ~/.sfjfx/sfjfx.properties  (o apuntar SFJFX_CONFIG a este archivo)
# y ajustar los valores.

# --- Base de datos ---
db.url=jdbc:postgresql://localhost:5432/sfjfx
db.usuario=sfjfx
db.password=sfjfx
db.esquema=public

# --- Aplicacion ---
app.entorno=dev

# --- Pool de conexiones (opcional) ---
# db.pool.maximo=10
# db.pool.minimo=1
# db.pool.timeout=30000

# --- Respaldos (opcional; se pueden configurar desde la UI) ---
# respaldo.directorio=~/.sfjfx/respaldos
# respaldo.programado=false
# respaldo.hora=23:00
# respaldo.pg_dump=pg_dump
# respaldo.pg_restore=pg_restore
